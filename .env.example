# ---------------------------------------------------------------------------
# Video Agent — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Per the Common Platform Specification, credentials are never logged.
# ---------------------------------------------------------------------------

# --- Video generation provider -------------------------------------------
# Magic Hour (https://magichour.ai) is the v1 video generation provider.
#
# WHY NOT HIGGSFIELD: the Video Agent PRD names "Higgsfield MCP" as the
# generation provider. Higgsfield exposes no free or trial API tier, and no
# credential was available for this build. Magic Hour was substituted because
# it satisfies the one capability the product cannot ship without —
# IMAGE_CONDITIONING, i.e. starting a clip from a supplied frame, which is what
# makes frame chaining (and therefore continuity) possible. The swap is
# absorbed entirely by the provider abstraction; no other module names a
# provider. See docs/LLD/providers.md.
#
# Get a key at https://magichour.ai/settings/developer — format: mhk_live_...
MAGICHOUR_API_KEY=
MAGICHOUR_BASE_URL=https://api.magichour.ai
# Model must support a 10s clip length and a start-frame image.
MAGICHOUR_MODEL=wan-2.2
MAGICHOUR_RESOLUTION=720p
# Optional: receives video.started / video.completed / video.errored instead of polling.
MAGICHOUR_WEBHOOK_SECRET=
# Magic Hour bills in credits at a tier-dependent rate, per 1,000 credits:
#   Starter 0.90 · Creator 1.20 · Pro 1.95 · Business 2.50
# Set this to YOUR account's tier. Volume discounts are deliberately NOT applied when
# evaluating the USD cap — discounting would lower computed spend and let a job run
# further before tripping the cap. Over-estimating is the safe direction for a cap.
MAGICHOUR_USD_PER_1K_CREDITS=0.90

# --- LLM gateway (LiteLLM — single egress for every LLM call) -------------
# Code references logical aliases only, never a provider. Aliases resolve here.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
# Upstream provider keys are held by the LiteLLM proxy, not by application code.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability ---------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Persistence -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://videoagent:videoagent@localhost:5432/videoagent
REDIS_URL=redis://localhost:6379/0

# --- Artifact storage (S3-compatible; presigned URLs are bearer credentials) -
ARTIFACT_BUCKET=video-agent-artifacts
ARTIFACT_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=3600

# --- Budget caps (hard, per the platform spec) -----------------------------
BUDGET_MAX_USD_PER_JOB=5.00
BUDGET_MAX_WALL_CLOCK_SECONDS=1200
BUDGET_MAX_TOKENS=250000
BUDGET_MAX_SUPERSTEPS=40
QC_ACCEPT_THRESHOLD=0.75
QC_MAX_REPAIR_ATTEMPTS=2

# --- Media toolchain -------------------------------------------------------
# ffmpeg and ffprobe must be the SAME release: a silent encoder change is an unlogged
# output change. The container image installs exactly FFMPEG_REQUIRED_VERSION.
# On a dev machine carrying more than one ffmpeg, name the matched pair explicitly —
# a standalone build in ~/.local/bin often ships ffmpeg WITHOUT ffprobe, so bare PATH
# resolution silently pairs binaries from two different releases.
FFMPEG_REQUIRED_VERSION=7.1
FFMPEG_BINARY=
FFPROBE_BINARY=

# --- App -------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
